{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Jule Module File",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#text"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.jule.mod",
					"match": "\\b(module|cpp|include|link)\\b"
				}
			]
		},
		"text": {
			"patterns": [
				{
					"begin": "\"",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.string.begin.jule.mod"
						}
					},
					"end": "\"",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.string.end.jule.mod"
						}
					},
					"name": "string.quoted.double.jule.mod"
				}
			]
		}
	},
	"scopeName": "jule.mod"
}